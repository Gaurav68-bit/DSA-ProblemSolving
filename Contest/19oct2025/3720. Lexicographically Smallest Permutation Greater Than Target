var lexGreaterPermutation = function(s, target) {
   const n = s.length;
  const freq = new Array(26).fill(0);

  for(let ch of s) 
      freq[ch.charCodeAt(0) - 97]++;

  const result = new Array(n).fill('?');
  const matchedPositions = []; 

  for (let i = 0; i < n; i++) {
    const t = target.charCodeAt(i) - 97;

    if (freq[t] > 0) {
      result[i] = target[i];
      freq[t]--;
      matchedPositions.push(i);
      continue;
    }

    let bigger = -1;
    for (let c = t + 1; c < 26; c++) {
      if (freq[c] > 0){
          bigger = c; break; }
    }

    if (bigger !== -1) {
      result[i] = String.fromCharCode(97 + bigger);
      freq[bigger]--;
      let pos = i + 1;
      for (let c = 0; c < 26; c++){
        while (freq[c]-- > 0) 
            result[pos++] = String.fromCharCode(97 + c);
      }
      return result.join('');
    }

    while (matchedPositions.length > 0) {
      const p = matchedPositions.pop();         
      const tp = target.charCodeAt(p) - 97;
      freq[tp]++;

      let bump = -1;
      for (let c = tp + 1; c < 26; c++) {
        if (freq[c] > 0){
            bump = c; break; 
        }
      }

      if (bump !== -1) {
        result[p] = String.fromCharCode(97 + bump);
        freq[bump]--;
        let pos = p + 1;
        for (let c = 0; c < 26; c++) {
          while (freq[c]-- > 0) 
              result[pos++] = String.fromCharCode(97 + c);
        }
        return result.join('');
      }
    }

    return "";
  }
  while (matchedPositions.length > 0) {
    const p = matchedPositions.pop();
    const tp = target.charCodeAt(p) - 97;
    freq[tp]++;

    let bump = -1;
    for (let c = tp + 1; c < 26; c++) if (freq[c] > 0) { bump = c; break; }

    if (bump !== -1) {
      result[p] = String.fromCharCode(97 + bump);
      freq[bump]--;
      let pos = p + 1;
      for (let c = 0; c < 26; c++) {
        while (freq[c]-- > 0) result[pos++] = String.fromCharCode(97 + c);
      }
      return result.join('');
    }
  }

  return "";
}