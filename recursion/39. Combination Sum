var combinationSum = function(candidates, target) {
    
    let result = [];
    let ans = [];
    function combiSum(sum,i)
    {
        if(i>=candidates.length || sum > target) return ;
        if(sum == target){
            result.push([...ans]);
            return;
        }
        ans.push(candidates[i]);
        combiSum(sum + candidates[i],i);
        ans.pop();
        combiSum(sum,i+1);
    }
    combiSum(0,0);
    return result;
};