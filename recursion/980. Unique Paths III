



var uniquePathsIII = function(grid) {
    let n = grid.length, m = grid[0].length;
    let empty = 1;  // count empty cells + starting cell
    let startX, startY;

    // Step 1: find start and count empty cells
    for (let i = 0; i < n; i++) {
        for (let j = 0; j < m; j++) {
            if (grid[i][j] === 0) empty++;
            else if (grid[i][j] === 1) {
                startX = i;
                startY = j;
            }
        }
    }

    // Step 2: define recursive DFS
    function dfs(x, y, remain) {
        // base conditions
        if (x < 0 || y < 0 || x >= n || y >= m || grid[x][y] === -1)
            return 0;
        if (grid[x][y] === 2)
            return remain === 0 ? 1 : 0;

        // mark current cell visited
        grid[x][y] = -1;

        // explore all directions
        let totalPaths = dfs(x + 1, y, remain - 1) +
                         dfs(x - 1, y, remain - 1) +
                         dfs(x, y + 1, remain - 1) +
                         dfs(x, y - 1, remain - 1);

        // backtrack
        grid[x][y] = 0;

        return totalPaths;
    }

    // Step 3: start recursion
    return dfs(startX, startY, empty);
};