var findSmallestInteger = function(nums, value) {
    let count = new Map();

    // Count frequency of each remainder (ensure non-negative remainder)
    for (let num of nums) {
        let r = ((num % value) + value) % value;
        count.set(r, (count.get(r) || 0) + 1);
    }

    // Try to form numbers from 0, 1, 2, ...
    for (let i = 0; ; i++) {
        let r = i % value;
        if (!count.get(r)) {
            // No available number with this remainder — can't form i
            return i;
        }
        // Use one number from this remainder class
        count.set(r, count.get(r) - 1);
    }
};