var maxIncreasingSubarrays = function(nums) {
  const n = nums.length;
  if (n < 2) return 0;

  // left[i] = length of strictly increasing subarray that ends at i
  const left = new Array(n).fill(1);
  for (let i = 1; i < n; i++) {
    left[i] = (nums[i] > nums[i - 1]) ? left[i - 1] + 1 : 1;
  }

  // right[i] = length of strictly increasing subarray that starts at i
  const right = new Array(n).fill(1);
  for (let i = n - 2; i >= 0; i--) {
    right[i] = (nums[i] < nums[i + 1]) ? right[i + 1] + 1 : 1;
  }

  // consider split between i and i+1
  let ans = 0;
  for (let i = 0; i < n - 1; i++) {
    const k = Math.min(left[i], right[i + 1]);
    if (k > ans) ans = k;
  }
  return ans;
};