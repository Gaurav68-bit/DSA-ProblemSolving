var findMaxConsecutiveOnes = function(nums) {
    let cnt = 0,ans = 0;
    for(let i = 0; i < nums.length; i++)
    {
        if(nums[i] == 1){
            cnt++;
        }
        else{
          ans = Math.max(ans,cnt);
          cnt = 0;
        }
    }
    ans = Math.max(ans,cnt);
    return ans;    
};