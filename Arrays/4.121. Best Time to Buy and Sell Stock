/*
here idea is 
  1. wee need to create an array which store the largest value from right side of the prices array. (which gives the most possible profit for every single element ie every transaction of the prices array)
  2. to find the max profit we need to see which transaction gives the most profit by trying every maxarr[i] - prices[i]
  3. Later we can do it by only a single varible because we just only need to remember the greater price and gradually doing i-- will gives the max profit. 
*/

//first approach by using an extra array

var maxProfit = function(prices) {
    let n = prices.length;
    let maxarr = Array(n);
    maxarr[n - 1] = prices[n - 1];
    for(let i = n - 2 ; i >= 0; i--)
    {
        if(prices[i] > maxarr[i + 1])
           maxarr[i] = prices[i];
        else{
            maxarr[i] = maxarr[i + 1];
        }   
    }
    let ans = -Infinity;

    for(let i = 0; i < n; i++)
    {
        ans = Math.max((maxarr[i] - prices[i]),ans);
    }
    return ans;

    
};

// second appraoch is by using a single variable

var maxProfit = function(prices) {
    let minPrice = prices[0];
    let maxProfit = 0;
    for(let i = 1;i < prices.length; i++)
    {
        if(prices[i] - minPrice > maxProfit)
          maxProfit = prices[i] - minPrice;



       if(prices[i] < minPrice) 
         minPrice = prices[i];

    }
    return maxProfit;
    
};