/*
Idea is just use two pointer i starts from 0 and j starts from 0.
i -> search for if an ele is 0 or not. if it is not zero then assign that ele into the jth index.
nums = [0,1,0,3,12]
Step 1: place 1 at index 0 → [1,1,0,3,12], j=1
Step 2: place 3 at index 1 → [1,3,0,3,12], j=2
Step 3: place 12 at index 2 → [1,3,12,3,12], j=3
Fill rest with 0 → [1,3,12,0,0]
*/



var moveZeroes = function(nums) {
    let j = 0;
    for(let i = 0; i < nums.length; i++)
    {
        if(nums[i] != 0)
         {nums[j] = nums[i];
         j++;
         }
    }
    for( ;j < nums.length; j++)
    {
        nums[j]  = 0;
    }
    
};