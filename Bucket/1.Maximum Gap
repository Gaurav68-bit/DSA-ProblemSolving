Solutions:- 

var maximumGap = function(nums) {
   let n = nums.length;
   if(n < 2) return 0;
    let maxEle = -Infinity,minEle =Infinity ;

    // finding the max and min ele
    for(let i = 0; i < n; i++)
    {
        if(nums[i] > maxEle) maxEle = nums[i];
        if(nums[i] < minEle) minEle = nums[i];
    }
    if(maxEle === minEle) return 0;
    let gap = Math.ceil((maxEle - minEle)/(n-1));
    let minArr = Array(n).fill(Infinity);
    let maxArr = Array(n).fill(-Infinity);

    //determine which ele goes to which arr ie minArr or max Arr
    for(let i = 0; i < n; i++)
    {
        let bucketIndex = Math.floor((nums[i] - minEle)/gap);

        if(nums[i] < minArr[bucketIndex])
          minArr[bucketIndex] = nums[i];
        if(nums[i] > maxArr[bucketIndex])
          maxArr[bucketIndex] = nums[i];  
    }

    //find the difference between minArr[i] - maxArr[i - 1] => this gives the difference of consecutive element
    let ans = -Infinity;
    let prev = -Infinity;
    for(let i = 0; i < n ;i++)
    {
        if(minArr[i] == Infinity)
          continue;
        if(prev == -Infinity)
           prev = maxArr[i];
        else {   
        ans = Math.max(ans,(minArr[i] - prev));
         prev = maxArr[i];
        }
    }
    return ans;
};